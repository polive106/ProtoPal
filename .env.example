# Server
NODE_ENV=development
PORT=3000

# Auth — required in all environments (min 32 characters)
JWT_SECRET=your-secret-at-least-32-characters-long

# Database — PGlite (embedded Postgres, local dev default). Data directory:
# DATABASE_PATH=./data/pglite

# Database — PostgreSQL server (production). Run `pnpm --filter @acme/database db:migrate` to apply migrations.
# DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# Database — MongoDB (alternative backend)
# MONGODB_URL=mongodb://localhost:27017/protopal

# CORS — comma-separated origins (defaults to localhost:5173 in dev)
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
